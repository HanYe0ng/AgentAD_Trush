# ── 데이터베이스 (SQLite, prisma/ 기준 경로) ─────────────────────────
DATABASE_URL="file:./agentad.db"

# ── 블록체인 ─────────────────────────────────────────────────────────
# localhost(로컬 Hardhat 노드) | sepolia
# 웹 앱은 deployments/<CHAIN_NETWORK>.json 에서 컨트랙트 주소와 역할 지갑을 읽는다.
CHAIN_NETWORK=localhost
# 서버가 체인을 조회할 RPC (생략 시 localhost=http://127.0.0.1:8545, sepolia=공개 RPC)
# CHAIN_RPC_URL=https://sepolia.infura.io/v3/<key>
# 브라우저(로컬 개발 키 서명)가 사용할 RPC (생략 시 CHAIN_RPC_URL)
# CHAIN_BROWSER_RPC_URL=

# ── 쇼핑 AI ──────────────────────────────────────────────────────────
# anthropic | rule  (생략 시 ANTHROPIC_API_KEY 가 있으면 anthropic, 없으면 규칙 기반 추천기)
# AI_PROVIDER=
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5

# ── 표시 이벤트 토큰 서명 키 (임의의 긴 문자열) ───────────────────────
DISPLAY_TOKEN_SECRET=change-me-to-a-long-random-string

# ── Sepolia 배포 전용 (npm run chain:deploy:sepolia) ─────────────────
# 비밀키는 가급적 `npx hardhat keystore set SEPOLIA_PRIVATE_KEY` 로 저장하세요.
# SEPOLIA_RPC_URL=
# SEPOLIA_PRIVATE_KEY=
# ADVERTISER_ADDRESS=0x...
# PUBLISHER_ADDRESS=0x...
# VERIFIER_ADDRESS=0x...
# ETHERSCAN_API_KEY=
